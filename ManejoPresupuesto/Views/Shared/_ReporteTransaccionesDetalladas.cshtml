@model ManejoPresupuesto.Models.ReporteTransaccionesDetallada;
<h4>
    <a asp-route-mes="@ViewBag.mesAnterior" asp-route-año="@ViewBag.añoAnterior" class="btn btn-secondary"><i class="bi-chevron-left"></i></a>
    @Model.FechaInicio.ToString("MMMM")-@Model.FechaInicio.Year
    <a asp-route-mes="@ViewBag.mesPosterior" asp-route-año="@ViewBag.añoPosterior" class="btn btn-secondary"><i class="bi-chevron-right"></i></a>

</h4>

<div id="contenedor-totales" class="mb-3">
    <div>
        <strong>Activos</strong>
        <div class="activo">
            @Model.BalanceDepositos.ToString("N")
        </div>
    </div>

    <div>
        <strong>Pasivos</strong>
        <div class="pasivo">
            @Model.BalanceRetiros.ToString("N")
        </div>
    </div>

    <div>
        <strong>Total</strong>
        <div>
            @Model.BalanceTotal.ToString("N")
        </div>
    </div>
</div>
@if (Model.TransaccionesAgrupadas.Count() == 0)
{
    <h5>No hay datos para mostrar</h5>
}
else
{
    <table class="table">
        <tbody>
            @foreach (var transaccionAgrupada in Model.TransaccionesAgrupadas)
            {
                <tr>
                    <td colspan="3" style="background-color: lightblue; font-size: 26px">
                        @transaccionAgrupada.FechaTransaccion.Day
                        <span class="badge bg-secondary">
                            @transaccionAgrupada.FechaTransaccion.ToString("ddd")
                        </span>
                    </td>
                    <td class="activo" style="background-color: lightblue; font-size: 26px">@transaccionAgrupada.BalanceDepositos.ToString("N")</td>
                    <td class="pasivo" style="background-color: lightblue; font-size: 26px">@transaccionAgrupada.BalanceRetiros.ToString("N")</td>
                </tr>

                @foreach (var transaccion in transaccionAgrupada.Transacciones)
                {
                    <tr style="vertical-align: middle">
                        <td>
                            <a asp-controller="transacciones" asp-action="Editar"
                               asp-route-id="@transaccion.Id" asp-route-urlRetorno="@ViewBag.urlRetorno">
                                <i class="bi-pencil"></i>
                            </a>
                        </td>
                        <td>@transaccion.Categoria</td>
                        <td>@transaccion.Cuenta</td>
                        <td class="activo">
                            @(transaccion.TipoOperacionId == TipoOperacion.Ingreso
                                            ? transaccion.Monto.ToString("N") : null)
                                                                                 </td>
                                                                                 <td class="pasivo">
                            @(transaccion.TipoOperacionId == TipoOperacion.Gasto
                                            ? transaccion.Monto.ToString("N") : null)
            </td>
        </tr>
                }
            }
        </tbody>
    </table>
}